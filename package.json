{
  "name": "lightly",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "program:build": "cd programs/poker && cargo-build-sbf",
    "program:test": "bun test programs/poker/tests/*.test.ts",
    "surfpool": "surfpool start",
    "idl:generate": "cd programs/poker && anchor idl build -o ../../packages/idl/poker.json && bun run idl:client",
    "idl:client": "codama run ts --path packages/idl/poker.json --output packages/idl/generated"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11"
}
